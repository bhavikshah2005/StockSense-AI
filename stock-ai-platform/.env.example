# Copy to .env and fill in local values. Do not commit .env.
# APP_ENV=production requires DATABASE_URL, COOKIE_SECURE=true, https FRONTEND_URL,
# and a REDIS_URL that is not localhost. Optional providers may stay empty.
APP_ENV=development

# Supabase PostgreSQL. Leave this empty here.
# Put the real connection string only in .env.
#
# Use the session pooler (port 5432) or the direct connection.
# Do not use the transaction pooler (port 6543): Alembic needs a session connection.
# Shape, with no real host or password:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Redis. Used for authentication rate limits and short-lived quote cache.
# Quotes are stored in PostgreSQL only after a historical sync. Redis is not the price database.
# Local: redis://127.0.0.1:6379/0
# Hosted TLS (Upstash and similar): rediss://default:[password]@your-host:6379
# Put the real URL only in .env or the deployed API environment.
REDIS_URL=redis://localhost:6379/0

# Comma-separated browser origins allowed to call the API with credentials.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Session cookie. The Render site and API are different hosts, so production
# uses COOKIE_SECURE=true and COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_EXPIRE_MINUTES=10080

# Leave empty until an email provider is connected. Reset links are not sent.
EMAIL_PROVIDER_API_KEY=

# Indian market data. Leave these empty until a vendor adapter is implemented
# in backend/app/data_providers/market_data. Put the real API key only in .env.
# The React app does not read these variables.
# Indian market data. `yahoo` is the built-in NSE/BSE adapter and does not need a key.
# It reads Yahoo Finance public chart and fundamentals feeds on the backend only.
# Set another name only after that vendor's adapter exists. The React app does not read these.
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=
# Seconds to reuse one quote across users. Keep this short. Allowed range: 1–900.
MARKET_DATA_QUOTE_TTL_SECONDS=15
# Seconds to reuse one history response. Allowed range: 1–3600.
MARKET_DATA_HISTORY_TTL_SECONDS=300
# Oldest daily history a MAX chart will request. Allowed range: 1–20.
MARKET_DATA_MAX_HISTORY_YEARS=10
# Watchlists are stored in PostgreSQL. These bounds apply to every user.
WATCHLIST_MAX_LISTS=20
WATCHLIST_MAX_STOCKS=50
WATCHLIST_NAME_MAX_LENGTH=80
WATCHLIST_DESCRIPTION_MAX_LENGTH=280
# Personal metric thresholds stored in PostgreSQL. Platform defaults are not editable here.
THRESHOLD_MAX_USER_OVERRIDES=100
# Alerts are stored in PostgreSQL. The worker does not promise real-time delivery.
ALERT_MAX_PER_USER=50
# Seconds between alert evaluation passes. Allowed range: 30–3600.
ALERT_EVAL_INTERVAL_SECONDS=300
# News. Leave NEWS_RSS_FEEDS empty until you have feeds you are allowed to store.
# The app keeps the headline, publisher, time, link, and a short plain-text excerpt.
# It does not copy the full article. rss is the only built-in provider.
NEWS_PROVIDER=
NEWS_RSS_FEEDS=
# Seconds between ingest passes. Allowed range: 60–86400.
NEWS_INGEST_INTERVAL_SECONDS=900
# Allowed range: 3–60.
NEWS_FETCH_TIMEOUT_SECONDS=15
# Allowed range: 1–100.
NEWS_MAX_ITEMS_PER_FEED=30
# Default feed window in days. Allowed range: 1–90.
NEWS_DEFAULT_WINDOW_DAYS=7
# AI research. Leave AI_PROVIDER empty until a backend key is available.
# The browser never receives AI_API_KEY. An empty provider stores evidence with status ai_unavailable.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# Allowed range: 5–120.
AI_TIMEOUT_SECONDS=30
# Allowed range: 100–4000.
AI_MAX_OUTPUT_TOKENS=800
# New runs per user per hour. Allowed range: 1–60. Reused runs do not count.
AI_RUNS_PER_HOUR=10
# Return the same input hash within this many minutes unless refresh=true. Allowed range: 0–1440.
AI_REUSE_MINUTES=30

# Indian fundamental data. Leave these empty until a vendor adapter is implemented
# in backend/app/data_providers/fundamentals. Put the real API key only in .env.
# The React app does not read these variables, and the placeholder does not call
# FUNDAMENTAL_API_BASE_URL.
# `yahoo` uses the same public Yahoo Finance feed for reported financials and valuation.
# No API key. Filing dates are not supplied by this feed.
FUNDAMENTAL_DATA_PROVIDER=yahoo
FUNDAMENTAL_API_KEY=
FUNDAMENTAL_API_BASE_URL=
# Seconds to reuse one fundamental or valuation response. Allowed range: 1–86400.
FUNDAMENTAL_CACHE_TTL_SECONDS=3600
# A stored report older than this is refreshed when a provider is configured.
FUNDAMENTAL_REPORT_STALE_HOURS=168
# A stored valuation older than this is refreshed when a provider is configured.
FUNDAMENTAL_VALUATION_STALE_HOURS=24

# Backtests read stored daily bars. They do not download history and they do not place orders.
# Allowed range for the calendar span: 30–1098. Saved runs per user: 1–100. Worker seconds: 5–300.
BACKTEST_MAX_CALENDAR_DAYS=1098
BACKTEST_MAX_RUNS=30
BACKTEST_WORKER_INTERVAL_SECONDS=30
# New backtest runs per user per hour. Allowed range: 1–60.
BACKTEST_RUNS_PER_HOUR=20
# Render and similar proxies: set FORWARDED_ALLOW_IPS=* only on that host.
# Leave it unset for local uvicorn.

# Frontend (Vite reads this file from the repository root)
VITE_API_BASE_URL=http://localhost:8000
